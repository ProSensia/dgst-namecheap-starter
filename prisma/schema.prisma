// DGST Grant Management & Project Lifecycle Platform
// Database schema - MySQL 8, normalized, indexed, transactional.
//
// Design notes (see /docs/ARCHITECTURE.md for full rationale):
// - Ids are random UUIDs (not auto-increment) to avoid sequential-id enumeration/IDOR.
// - "Configurable without code changes" areas (applicant categories, report templates,
//   legal document templates, roles/permissions) store a JSON fieldSchema/instructions
//   rather than hardcoded columns, so Directorate staff can add/adjust these from the
//   admin UI once the module ships.
// - Attachment is a single polymorphic file-metadata table used by every module that
//   accepts uploads, so "document type/project/uploader/version/status" (spec #17) is
//   modeled once, not five times.
// - AuditLog rows are hash-chained (previousHash/recordHash) for tamper-evidence beyond
//   what "no UPDATE/DELETE grant" alone provides.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity, Roles & Permissions
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles            UserRole[]
  applicantProfile ApplicantProfile?

  refreshTokens        RefreshToken[]
  applicationsDecided  Application[]        @relation("ApplicationDecidedBy")
  projectsAsPI         Project[]            @relation("ProjectPrincipalInvestigator")
  statusChanges        ProjectStatusHistory[] @relation("StatusChangedBy")
  awardLettersIssued   AwardLetter[]        @relation("AwardLetterIssuedBy")
  legalDocsReviewed    LegalDocument[]      @relation("LegalDocumentReviewedBy")
  disbursementsRecorded Disbursement[]      @relation("DisbursementRecordedBy")
  expensesCreated      Expense[]            @relation("ExpenseCreatedBy")
  reportsDecided       Report[]             @relation("ReportDecidedBy")
  reportVersionsSubmitted ReportVersion[]   @relation("ReportVersionSubmittedBy")
  reportComments       ReportComment[]      @relation("ReportCommentAuthor")
  progressUpdatesCreated ProgressUpdate[]   @relation("ProgressUpdateCreatedBy")
  attachmentsUploaded  Attachment[]         @relation("AttachmentUploadedBy")
  notifications        Notification[]
  messagesSent         Message[]            @relation("MessageSender")
  threadsCreated       MessageThread[]      @relation("ThreadCreatedBy")
  certificatesIssued   Certificate[]        @relation("CertificateIssuedBy")
  verificationsIssued  VerificationRecord[] @relation("VerificationIssuedBy")
  auditLogs            AuditLog[]           @relation("AuditActor")

  @@index([status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // seeded roles (e.g. Super Admin) cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  REJECT
  VERIFY
  REQUEST_CORRECTION
  DOWNLOAD
  EXPORT
  COMMUNICATE
  MANAGE_USERS
}

// `resource` is a free-form catalog key (e.g. "PROGRAM", "REPORT", "LEGAL_DOCUMENT"),
// seeded per module as it ships. The (resource, action) pair is what a route's
// @RequirePermissions() decorator checks for.
model Permission {
  id       String            @id @default(uuid())
  resource String
  action   PermissionAction
  label    String

  roles RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ---------------------------------------------------------------------------
// Applicant profiles (student / researcher / faculty / university / startup / ...)
// ---------------------------------------------------------------------------

// Admin-configurable applicant type, e.g. STUDENT, RESEARCHER, FACULTY, UNIVERSITY,
// STARTUP, COMPANY, OTHER - stored as data (not an enum) so new categories can be
// added without a code change. `profileFieldSchema` is a FormSchema (see
// src/common/form-schema/form-schema.types.ts) describing the category-specific
// fields captured in ApplicantProfile.profileData.
model ApplicantCategory {
  id                 String   @id @default(uuid())
  code               String   @unique
  name               String
  description        String?  @db.Text
  profileFieldSchema Json
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  profiles ApplicantProfile[]
}

model ApplicantProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  categoryId      String
  institutionName String?
  department      String?
  profileData     Json // category-specific fields, validated against category.profileFieldSchema
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     ApplicantCategory @relation(fields: [categoryId], references: [id])
  applications Application[]

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Funding calls / programs
// ---------------------------------------------------------------------------

enum ProgramStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model Program {
  id                 String        @id @default(uuid())
  code               String        @unique // e.g. UGRS, PPS
  title              String
  description        String        @db.Text
  status             ProgramStatus @default(DRAFT)
  applicationOpenAt  DateTime?
  applicationDeadline DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  fundingCategories    FundingCategory[]
  requiredDocumentTypes RequiredDocumentType[]
  eligibilityCriteria  EligibilityCriterion[]
  applications         Application[]
  projects             Project[]
  reportTemplates      ReportTemplate[]

  @@index([status])
}

model FundingCategory {
  id         String  @id @default(uuid())
  programId  String
  name       String
  minAmount  Decimal @db.Decimal(14, 2)
  maxAmount  Decimal @db.Decimal(14, 2)

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([programId])
}

model RequiredDocumentType {
  id        String  @id @default(uuid())
  programId String
  name      String
  description String?
  mandatory Boolean @default(true)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model EligibilityCriterion {
  id          String @id @default(uuid())
  programId   String
  description String @db.Text

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

// ---------------------------------------------------------------------------
// Applications
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  SHORTLISTED
  APPROVED
  REJECTED
}

model Application {
  id                String            @id @default(uuid())
  programId         String
  applicantId       String
  fundingCategoryId String?
  title             String
  summary           String            @db.Text
  requestedAmount   Decimal           @db.Decimal(14, 2)
  status            ApplicationStatus @default(DRAFT)
  submittedAt       DateTime?
  decisionAt        DateTime?
  decisionByUserId  String?
  decisionRemarks   String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  program         Program           @relation(fields: [programId], references: [id])
  applicant       ApplicantProfile  @relation(fields: [applicantId], references: [id])
  fundingCategory FundingCategory?  @relation(fields: [fundingCategoryId], references: [id])
  decisionBy      User?             @relation("ApplicationDecidedBy", fields: [decisionByUserId], references: [id])
  project         Project?

  @@index([programId])
  @@index([applicantId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Projects / Awards
// ---------------------------------------------------------------------------

enum ProjectStatus {
  APPLICATION
  APPROVED
  AWARDED
  LEGAL_DOCUMENTATION
  FUNDED
  IN_PROGRESS
  REPORTING
  VERIFICATION
  COMPLETED
  CLOSED
  REJECTED
}

model Project {
  id                     String        @id @default(uuid())
  projectCode            String        @unique // human-readable unique Project ID, e.g. DGST-UGRS-2026-000123
  applicationId          String        @unique
  programId              String
  principalInvestigatorId String
  title                  String
  status                 ProjectStatus @default(APPROVED)
  approvedAmount         Decimal       @db.Decimal(14, 2)
  startDate              DateTime?
  endDate                DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  application             Application        @relation(fields: [applicationId], references: [id])
  program                  Program            @relation(fields: [programId], references: [id])
  principalInvestigator    User               @relation("ProjectPrincipalInvestigator", fields: [principalInvestigatorId], references: [id])
  statusHistory            ProjectStatusHistory[]
  awardLetter              AwardLetter?
  legalDocuments           LegalDocument[]
  budgets                  Budget[]
  disbursements            Disbursement[]
  expenses                 Expense[]
  reports                  Report[]
  progressUpdates          ProgressUpdate[]
  messageThreads           MessageThread[]
  certificate              Certificate?

  @@index([status])
  @@index([programId])
  @@index([principalInvestigatorId])
}

// Backs atomic, collision-free Project ID generation (DGST-{programCode}-{year}-{seq}):
// incrementing lastValue via Prisma's `{ increment: 1 }` compiles to a single atomic
// UPDATE in MySQL, so concurrent approvals for the same program/year can never race
// each other into issuing the same number.
model ProgramYearSequence {
  id        String @id @default(uuid())
  programId String
  year      Int
  lastValue Int    @default(0)

  @@unique([programId, year])
}

model ProjectStatusHistory {
  id             String        @id @default(uuid())
  projectId      String
  fromStatus     ProjectStatus?
  toStatus       ProjectStatus
  changedByUserId String
  remarks        String?       @db.Text
  createdAt      DateTime      @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changedBy User    @relation("StatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([projectId])
}

model AwardLetter {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  attachmentId         String   @unique
  issuedByUserId        String
  issueDate            DateTime
  verificationRecordId String?  @unique
  createdAt            DateTime @default(now())

  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachment         Attachment         @relation(fields: [attachmentId], references: [id])
  issuedBy           User               @relation("AwardLetterIssuedBy", fields: [issuedByUserId], references: [id])
  verificationRecord VerificationRecord? @relation(fields: [verificationRecordId], references: [id])
}

// ---------------------------------------------------------------------------
// Legal / Stamp-paper documentation
// ---------------------------------------------------------------------------

enum LegalDocumentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  VERIFIED
  APPROVED
  REJECTED
}

// Admin-configurable stamp-paper / legal-document format. `instructionsHtml` +
// `prescribedFormatAttachmentId` hold the official format once the Directorate
// supplies it; `fieldSchema` drives the data-capture form.
model LegalDocumentTemplate {
  id                          String   @id @default(uuid())
  code                        String   @unique
  name                        String
  instructionsHtml            String   @db.Text
  prescribedFormatAttachmentId String?
  fieldSchema                 Json
  isActive                    Boolean  @default(true)
  createdAt                   DateTime @default(now())

  legalDocuments LegalDocument[]
}

model LegalDocument {
  id                   String              @id @default(uuid())
  projectId            String
  templateId           String
  capturedData         Json
  executedAttachmentId String?
  status               LegalDocumentStatus @default(DRAFT)
  reviewerUserId        String?
  reviewRemarks        String?             @db.Text
  submittedAt          DateTime?
  decidedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  project  Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template LegalDocumentTemplate  @relation(fields: [templateId], references: [id])
  reviewer User?                  @relation("LegalDocumentReviewedBy", fields: [reviewerUserId], references: [id])

  @@index([projectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Financials: budgets, disbursements, expenses, bills
// ---------------------------------------------------------------------------

model Budget {
  id             String  @id @default(uuid())
  projectId      String
  categoryName   String // budget head, e.g. "Equipment", "Consumables", "Travel"
  approvedAmount Decimal @db.Decimal(14, 2)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([projectId])
}

model Disbursement {
  id               String   @id @default(uuid())
  projectId        String
  amount           Decimal  @db.Decimal(14, 2)
  disbursementDate DateTime
  referenceNumber  String
  method           String?
  remarks          String?  @db.Text
  recordedByUserId  String
  createdAt        DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("DisbursementRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([projectId])
}

enum ExpenseStatus {
  RECORDED
  FLAGGED
  VERIFIED
}

model Expense {
  id              String        @id @default(uuid())
  projectId       String
  budgetId        String?
  title           String
  category        String
  description     String?       @db.Text
  itemName        String
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(14, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  vendorName      String?
  purchaseDate    DateTime
  objective       String?       @db.Text
  billNumber      String?
  status          ExpenseStatus @default(RECORDED)
  createdByUserId  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget      Budget?  @relation(fields: [budgetId], references: [id])
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  bills       Bill[]

  @@index([projectId])
  @@index([budgetId])
}

model Bill {
  id           String   @id @default(uuid())
  expenseId    String
  billNumber   String?
  amount       Decimal  @db.Decimal(14, 2)
  attachmentId String?  @unique
  createdAt    DateTime @default(now())

  expense    Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  attachment Attachment? @relation(fields: [attachmentId], references: [id])

  @@index([expenseId])
}

// ---------------------------------------------------------------------------
// Reporting engine
// ---------------------------------------------------------------------------

enum ReportCategory {
  PROGRESS
  FINANCIAL
  EXPENSE
  UTILIZATION
  TECHNICAL
  DELIVERABLES
  SUPPORTING
  FINAL
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPROVED
  REJECTED
}

// Admin-configurable report format. `fieldSchema` is a FormSchema rendered generically
// by the frontend; `prescribedFormatAttachmentId` can hold the official Directorate
// document (e.g. the original .docx) for reference/download. Seeded initially from the
// real UGRS/PPS formats under /Reports_Format.
model ReportTemplate {
  id                          String         @id @default(uuid())
  programId                   String?        // null = usable across programs
  code                        String         @unique
  name                        String
  category                    ReportCategory
  periodicity                 String? // e.g. "QUARTERLY", "ONCE"
  instructions                String?        @db.Text
  fieldSchema                 Json
  prescribedFormatAttachmentId String?
  isActive                    Boolean        @default(true)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  program Program? @relation(fields: [programId], references: [id])
  reports Report[]

  @@index([programId])
}

model Report {
  id                  String       @id @default(uuid())
  projectId           String
  templateId          String
  title                String
  periodLabel         String?
  periodStart         DateTime?
  periodEnd           DateTime?
  data                Json
  status              ReportStatus @default(DRAFT)
  currentVersionNumber Int         @default(0)
  submittedAt          DateTime?
  decidedAt            DateTime?
  decidedByUserId       String?
  decisionRemarks      String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template    ReportTemplate  @relation(fields: [templateId], references: [id])
  decidedBy   User?           @relation("ReportDecidedBy", fields: [decidedByUserId], references: [id])
  versions    ReportVersion[]
  comments    ReportComment[]
  verificationRecordId String? @unique
  verificationRecord    VerificationRecord? @relation(fields: [verificationRecordId], references: [id])

  @@index([projectId])
  @@index([status])
  @@index([templateId])
}

// Immutable snapshot of a report's data at each submission - gives version history
// and lets a correction cycle produce a new version instead of editing in place.
model ReportVersion {
  id                 String   @id @default(uuid())
  reportId           String
  versionNumber      Int
  data               Json
  submittedByUserId   String
  pdfAttachmentId    String?
  createdAt          DateTime @default(now())

  report        Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  submittedBy   User   @relation("ReportVersionSubmittedBy", fields: [submittedByUserId], references: [id])

  @@unique([reportId, versionNumber])
}

model ReportComment {
  id            String   @id @default(uuid())
  reportId      String
  versionNumber Int?
  authorUserId   String
  comment       String   @db.Text
  createdAt     DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User   @relation("ReportCommentAuthor", fields: [authorUserId], references: [id])

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Progress tracking (milestones / achievements / problems / deliverables)
// ---------------------------------------------------------------------------

enum ProgressUpdateType {
  MILESTONE
  ACHIEVEMENT
  PROBLEM_DELAY
  DELIVERABLE
  PUBLICATION
  GENERAL_UPDATE
}

model ProgressUpdate {
  id             String             @id @default(uuid())
  projectId      String
  type           ProgressUpdateType
  title          String
  description    String             @db.Text
  occurredOn     DateTime?
  createdByUserId String
  createdAt      DateTime           @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProgressUpdateCreatedBy", fields: [createdByUserId], references: [id])

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Generic file/attachment metadata (spec #17) - physical bytes live in StorageService
// ---------------------------------------------------------------------------

enum AttachmentOwnerType {
  APPLICATION
  PROJECT
  AWARD_LETTER
  LEGAL_DOCUMENT
  LEGAL_DOCUMENT_TEMPLATE
  EXPENSE
  BILL
  REPORT
  REPORT_TEMPLATE
  PROGRESS_UPDATE
  CERTIFICATE
  MESSAGE
}

enum AttachmentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Attachment {
  id              String              @id @default(uuid())
  ownerType       AttachmentOwnerType
  ownerId         String
  category        String
  originalFilename String
  storageKey      String              @unique
  mimeType        String
  sizeBytes       Int
  checksumSha256  String
  version         Int                 @default(1)
  status          AttachmentStatus    @default(PENDING)
  uploadedByUserId String
  createdAt       DateTime            @default(now())

  uploadedBy  User          @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  awardLetter AwardLetter?
  bill        Bill?

  @@index([ownerType, ownerId])
}

// ---------------------------------------------------------------------------
// Notifications & internal messaging
// ---------------------------------------------------------------------------

enum NotificationType {
  NEW_AWARD
  DOCUMENT_REJECTED
  CORRECTION_REQUESTED
  REPORT_DUE
  REPORT_APPROVED
  DISBURSEMENT_RECORDED
  DEADLINE_APPROACHING
  PROJECT_COMPLETED
  CERTIFICATE_ISSUED
  GENERAL
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  type             NotificationType
  title            String
  body             String           @db.Text
  relatedEntityType String?
  relatedEntityId  String?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model MessageThread {
  id            String   @id @default(uuid())
  projectId     String
  subject       String
  createdByUserId String
  createdAt     DateTime @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ThreadCreatedBy", fields: [createdByUserId], references: [id])
  messages  Message[]

  @@index([projectId])
}

model Message {
  id           String   @id @default(uuid())
  threadId     String
  senderUserId  String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation("MessageSender", fields: [senderUserId], references: [id])

  @@index([threadId])
}

// ---------------------------------------------------------------------------
// Certificates
// ---------------------------------------------------------------------------

model Certificate {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  certificateNumber    String   @unique
  issueDate            DateTime
  issuedByUserId        String
  pdfAttachmentId      String?
  verificationRecordId String?  @unique
  createdAt            DateTime @default(now())

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issuedBy           User                @relation("CertificateIssuedBy", fields: [issuedByUserId], references: [id])
  verificationRecord VerificationRecord? @relation(fields: [verificationRecordId], references: [id])
}

// ---------------------------------------------------------------------------
// QR / public verification
// ---------------------------------------------------------------------------

enum VerificationEntityType {
  PROJECT
  AWARD_LETTER
  REPORT
  CERTIFICATE
  LEGAL_DOCUMENT
}

enum VerificationStatus {
  ACTIVE
  REVOKED
}

// id is the public verification identifier encoded in the QR/URL - a 128-bit random
// UUID, not derived from or guessable via the underlying entity's id. The public verify
// endpoint does a live lookup and returns only the minimal whitelisted fields (spec #10);
// it never echoes financial/personal data.
model VerificationRecord {
  id             String              @id @default(uuid())
  entityType     VerificationEntityType
  entityId       String
  status         VerificationStatus @default(ACTIVE)
  issuedByUserId  String
  createdAt      DateTime            @default(now())
  revokedAt      DateTime?
  revokedReason  String?

  issuedBy    User               @relation("VerificationIssuedBy", fields: [issuedByUserId], references: [id])
  scanLogs    VerificationScanLog[]
  awardLetter AwardLetter?
  report      Report?
  certificate Certificate?

  @@index([entityType, entityId])
}

model VerificationScanLog {
  id                   String   @id @default(uuid())
  verificationRecordId String
  ipAddress            String?
  userAgent            String?
  resultStatus         String
  scannedAt            DateTime @default(now())

  verificationRecord VerificationRecord @relation(fields: [verificationRecordId], references: [id], onDelete: Cascade)

  @@index([verificationRecordId])
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  seq           Int      @unique @default(autoincrement())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
  previousHash  String
  recordHash    String

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}
