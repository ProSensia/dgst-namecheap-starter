# --- MySQL (update these once you create the database in cPanel -> MySQL Databases) ---
# cPanel-created DB/user names are usually prefixed with your cPanel username, e.g.
# cpaneluser_dgst_grants / cpaneluser_dgst_user
DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3306/your_db_name"

# --- Server ---
# cPanel's Node.js App Selector sets its own PORT env var for the app automatically -
# leave this as a fallback for running the app outside cPanel (e.g. local testing).
PORT=4000
NODE_ENV=production

# --- Auth (generate real random values before going live, e.g. `openssl rand -hex 32`) ---
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Storage ---
STORAGE_ROOT="./storage"

# --- Origin / verification links ---
# Frontend is served by this same app (see dist/public), so these should both be your
# real domain once you point it at Namecheap - e.g. https://grants.yourdomain.com
WEB_ORIGIN="https://yourdomain.com"
PUBLIC_VERIFY_BASE_URL="https://yourdomain.com/verify"
